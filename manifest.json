{
  "manifest_version": 3,
  "name": "Simple Chat for Kick",
  "version": "1.0.1",
  "description": "Plain-text Kick chat — no emotes, badges, gifs or sub spam. Read back deleted messages. Purple theme, player locked to 1080p.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["*://*.kick.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.kick.com/*"],
      "js": ["src/content.js"],
      "css": ["src/kick.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://*.kick.com/*"],
      "js": [
        "src/quality.js",
        "src/browse.js",
        "src/chatlog.js",
        "src/justchat.js",
        "src/chatfilter.js",
        "src/chatscroll.js",
        "src/diag.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Simple Chat for Kick",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
